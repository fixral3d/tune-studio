  "fields": [
   {
    "name": "pw16",
    "size": "4 hex chars"
   }
  ],
  "response": "'pwOK'",
  "timeout_ms": "m_timeout",
  "source": "PasswordChecker::sendPw @0x00e28460, waitPw @0x00e28908, PasswordHelper::resolveMagic @0x00bae7a0",
  "area": "core"
 },
 {
  "name": "TF_FRAME",
  "mode": "triggerframe",
  "direction": "both",
  "bytes": "escape(body || crc16_modbus(body) LE) || 7E; escape 7D->7D 5D, 7E->7D 5E",
  "fields": [
   {
    "name": "data",
    "size": "0..n"
   },
   {
    "name": "value",
    "size": "0/1/2/4 (1 for F5, 2 BE for F4/F9/FB, else 4: 00 b2 b1 b0)"
   },
   {
    "name": "subtype",
    "size": "0/1"
   },
   {
    "name": "type",
    "size": 1
   }
  ],
  "response": "type-0x80 for requests >=0x80",
  "source": "TriggerFrame::create @0x00e970e8, TriggerFrameEx::create @0x0081eaf8, TriggerFrameFSM::parse @0x0082056c",
  "area": "core"
 },
 {
  "name": "TF_ERROR",
  "mode": "triggerframe",
  "direction": "ecu->host",
  "type": "0x7F",
  "bytes": "[reason] [category] 7F",
  "fields": [
   {
    "name": "reason",
    "size": 1,
    "note": "1 NO_SUBTYPE/NO_PARAMETER, 2 BAD_SUBTYPE/CANT_GO/BUSY/OVERWRITE, 3..9 TEST_TOOLS missing param"
   },
   {
    "name": "category",
    "size": 1,
    "note": "1 UNKNOWN_COMMAND,2 CRC,3 SD_BASE,4 ECU_DETAILS,5 SD_CMD,6 GO_BOOTLOADER,7 CHANGE_BAUD,8 TEST_TOOLS,9 EEPROM_CONTROL,0x0A SRAM_WRITE"
   }
  ],
  "example": "CRC error: 02 7F 41 30 7E",
  "host_action": "category 2 -> resend same request up to 3x",
  "source": "TriggerFrame::getErrorSubTypeAsString @0x008196ca, SynchronousHandler::onReceiveTriggerFrame @0x00817a70",
  "area": "core"
 },
 {
