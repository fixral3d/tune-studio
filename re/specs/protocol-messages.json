  "direction": "host->ecu",
  "bytes": "2E",
  "fields": [],
  "response": "locked: 'BAD pw\\r\\n' + serial matching (\\w\\d.\\d_\\w\\d{6}); unlocked: silence until m_timeout",
  "timeout_ms": "m_timeout",
  "source": "PasswordChecker::write @0x00e288c4, waitP @0x00e28a44",
  "area": "core"
 },
 {
  "name": "PASSWORD_SEND",
